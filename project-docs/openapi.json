        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "slug": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Workspace updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } } } }
