{
  "openapi": "3.1.0",
  "info": {
    "title": "Actor Platform API",
    "version": "0.0.1",
    "description": "API for managing actors, runs, schedules, storage, and webhooks on the actor automation platform."
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Local development" }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "tags": ["System"],
        "security": [],
        "responses": {
          "200": {
            "description": "Service health status",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          }
        }
      }
    },
    "/console": {
      "get": {
        "summary": "Actor Console UI",
        "tags": ["System"],
        "security": [],
        "responses": { "200": { "description": "HTML console page" } }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "OpenAPI specification",
        "tags": ["System"],
        "security": [],
        "responses": { "200": { "description": "OpenAPI 3.1 spec" } }
      }
    },
    "/docs": {
      "get": {
        "summary": "Swagger UI documentation",
        "tags": ["System"],
        "security": [],
        "responses": { "200": { "description": "Swagger UI HTML page" } }
      }
    },
    "/runs": {
      "post": {
        "summary": "Create a run",
        "tags": ["Runs"],
        "security": [{ "bearerAuth": ["runs:write"] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRunInput" } } } },
        "responses": {
          "201": { "description": "Run created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActorRun" } } } },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/runs/{id}": {
      "get": {
        "summary": "Get run by ID",
        "tags": ["Runs"],
        "security": [{ "bearerAuth": ["runs:read"] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Run details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActorRun" } } } } }
      },
      "patch": {
        "summary": "Update run status",
        "tags": ["Runs"],
        "security": [{ "bearerAuth": ["runs:write"] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateRunInput" } } } },
        "responses": { "200": { "description": "Run updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActorRun" } } } } }
      }
    },
