# ─── Actor Platform Environment Configuration ───
# Copy to .env and fill in values

NODE_ENV=development
PORT=3000

# PostgreSQL connection strings (Supabase format)
# DATABASE_URL: Pooled connection for runtime (use ?pgbouncer=true&connection_limit=1 for serverless)
# DIRECT_URL:  Direct connection for migrations (prisma migrate deploy)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
