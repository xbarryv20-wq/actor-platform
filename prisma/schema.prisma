generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  workspaces  Workspace[]
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

enum ActorRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  actors        Actor[]
  runs          ActorRun[]
  datasets      Dataset[]
  kvStores      KeyValueStore[]
  requestQueues RequestQueue[]

  @@unique([organizationId, slug])
}

model Actor {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id])
  versions  ActorVersion[]
  runs      ActorRun[]

  @@unique([workspaceId, slug])
}

model ActorVersion {
  id              String   @id @default(cuid())
  actorId         String
  version         Int
  sourceReference String?
  changelog       String?
  createdAt       DateTime @default(now())

  actor Actor      @relation(fields: [actorId], references: [id])
  runs  ActorRun[]

  @@unique([actorId, version])
}

model ActorRun {
  id             String          @id @default(cuid())
  actorId        String
  actorVersionId String?
  workspaceId    String
  status         ActorRunStatus  @default(PENDING)
  input          Json?
  output         Json?
  errorMessage   String?
  createdAt      DateTime        @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  actor        Actor         @relation(fields: [actorId], references: [id])
  actorVersion ActorVersion? @relation(fields: [actorVersionId], references: [id])
  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  datasets     Dataset[]
  kvStores     KeyValueStore[]
  requestQueues RequestQueue[]

  @@index([workspaceId])
  @@index([actorId])
  @@index([status])
}

model Dataset {
  id          String   @id @default(cuid())
  workspaceId String
  actorRunId  String?
  name        String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id])
  actorRun  ActorRun?    @relation(fields: [actorRunId], references: [id])
  items     DatasetItem[]

  @@unique([workspaceId, slug])
  @@index([actorRunId])
}

model DatasetItem {
  id        String   @id @default(cuid())
  datasetId String
  sequence  Int
  payload   Json
  createdAt DateTime @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id])

  @@index([datasetId, sequence])
}

model KeyValueStore {
  id          String   @id @default(cuid())
  workspaceId String
  actorRunId  String?
  name        String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id])
  actorRun  ActorRun?       @relation(fields: [actorRunId], references: [id])
  records   KeyValueRecord[]

  @@unique([workspaceId, slug])
  @@index([actorRunId])
}

model KeyValueRecord {
  id          String   @id @default(cuid())
  storeId     String
  key         String
  value       Json
  contentType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store KeyValueStore @relation(fields: [storeId], references: [id])

  @@unique([storeId, key])
}

model RequestQueue {
  id          String   @id @default(cuid())
  workspaceId String
  actorRunId  String?
  name        String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  actorRun  ActorRun?        @relation(fields: [actorRunId], references: [id])
  items     RequestQueueItem[]

  @@unique([workspaceId, slug])
  @@index([actorRunId])
}

model RequestQueueItem {
  id         String    @id @default(cuid())
  queueId    String
  uniqueKey  String
  url        String?
  payload    Json?
  status     String    @default("PENDING")
  retryCount Int       @default(0)
  handledAt  DateTime?
  createdAt  DateTime  @default(now())

  queue RequestQueue @relation(fields: [queueId], references: [id])

  @@unique([queueId, uniqueKey])
  @@index([queueId, status])
}
