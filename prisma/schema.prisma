generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          Membership[]
  apiTokens            ApiToken[]
  workspaceMemberships WorkspaceMembership[]
  ownedActors          Actor[]
  ownedDatasets        Dataset[]
  ownedKvStores        KeyValueStore[]
  ownedRequestQueues   RequestQueue[]
  ownedWebhooks        Webhook[]
  marketplaceListings  MarketplaceListing[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  workspaces  Workspace[]
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

enum ActorStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

enum ActorRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id])
  actors               Actor[]
  runs                 ActorRun[]
  datasets             Dataset[]
  kvStores             KeyValueStore[]
  requestQueues        RequestQueue[]
  schedules            Schedule[]
  workspaceMemberships WorkspaceMembership[]
  webhooks             Webhook[]

  @@unique([organizationId, slug])
}

model WorkspaceMembership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String   @default("MEMBER")
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Actor {
  id          String      @id @default(cuid())
  workspaceId String
  ownerId     String?
  name        String
  slug        String
  description String?
  tags        String[]
  icon        String?
  status      ActorStatus @default(DRAFT)
  inputSchema Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id])
  owner     User?          @relation(fields: [ownerId], references: [id])
  versions  ActorVersion[]
  runs      ActorRun[]
  schedules Schedule[]
  webhooks  Webhook[]
  listings  MarketplaceListing[]

  @@unique([workspaceId, slug])
  @@index([ownerId])
}

model ActorVersion {
  id              String   @id @default(cuid())
  actorId         String
  version         Int
  inputSchema     Json?
  sourceReference String?
  changelog       String?
  createdAt       DateTime @default(now())

  actor     Actor      @relation(fields: [actorId], references: [id])
  runs      ActorRun[]
  schedules Schedule[]

  @@unique([actorId, version])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  label      String
  scopes     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ActorRun {
  id             String         @id @default(cuid())
  actorId        String
  actorVersionId String?
  workspaceId    String
  status         ActorRunStatus @default(PENDING)
  input          Json?
  output         Json?
  errorMessage   String?
  createdAt      DateTime       @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  actor         Actor           @relation(fields: [actorId], references: [id])
  actorVersion  ActorVersion?   @relation(fields: [actorVersionId], references: [id])
  workspace     Workspace       @relation(fields: [workspaceId], references: [id])
  datasets      Dataset[]
  kvStores      KeyValueStore[]
  requestQueues RequestQueue[]
  logs          LogEntry[]

  @@index([workspaceId])
  @@index([actorId])
  @@index([status])
}

model Dataset {
  id          String   @id @default(cuid())
  workspaceId String
  actorRunId  String?
  ownerId     String?
  name        String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id])
  actorRun  ActorRun?     @relation(fields: [actorRunId], references: [id])
  owner     User?         @relation(fields: [ownerId], references: [id])
  items     DatasetItem[]

  @@unique([workspaceId, slug])
  @@index([actorRunId])
  @@index([ownerId])
}

model DatasetItem {
  id        String   @id @default(cuid())
  datasetId String
  sequence  Int
  payload   Json
  createdAt DateTime @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id])

  @@index([datasetId, sequence])
}

model KeyValueStore {
  id          String   @id @default(cuid())
  workspaceId String
  actorRunId  String?
  ownerId     String?
  name        String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  actorRun  ActorRun?        @relation(fields: [actorRunId], references: [id])
  owner     User?            @relation(fields: [ownerId], references: [id])
  records   KeyValueRecord[]

  @@unique([workspaceId, slug])
  @@index([actorRunId])
  @@index([ownerId])
}

model KeyValueRecord {
  id          String   @id @default(cuid())
  storeId     String
  key         String
  value       Json
  contentType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store KeyValueStore @relation(fields: [storeId], references: [id])

  @@unique([storeId, key])
}

model RequestQueue {
  id          String   @id @default(cuid())
  workspaceId String
  actorRunId  String?
  ownerId     String?
  name        String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id])
  actorRun  ActorRun?          @relation(fields: [actorRunId], references: [id])
  owner     User?              @relation(fields: [ownerId], references: [id])
  items     RequestQueueItem[]

  @@unique([workspaceId, slug])
  @@index([actorRunId])
  @@index([ownerId])
}

model Schedule {
  id             String    @id @default(cuid())
  workspaceId    String
  actorId        String
  actorVersionId String?
  cronExpression String
  inputOverride  Json?
  enabled        Boolean   @default(true)
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  actor        Actor         @relation(fields: [actorId], references: [id])
  actorVersion ActorVersion? @relation(fields: [actorVersionId], references: [id])

  @@index([workspaceId])
  @@index([enabled, nextRunAt])
}

model Webhook {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String
  ownerId     String?
  eventTypes  String
  url         String
  secret      String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  actor     Actor            @relation(fields: [actorId], references: [id])
  owner     User?            @relation(fields: [ownerId], references: [id])
  attempts  WebhookAttempt[]

  @@index([workspaceId])
  @@index([actorId])
  @@index([ownerId])
}

enum WebhookAttemptStatus {
  PENDING
  DELIVERING
  RETRYING
  SUCCEEDED
  FAILED
}

model WebhookAttempt {
  id                 String                @id @default(cuid())
  webhookId          String
  eventType          String
  status             WebhookAttemptStatus  @default(PENDING)
  attemptCount       Int                   @default(1)
  requestUrl         String
  requestBody        String?
  responseStatusCode  Int?
  responseBody       String?
  errorMessage       String?
  nextRetryAt        DateTime?
  lastRetryAt        DateTime?
  createdAt          DateTime              @default(now())
  completedAt        DateTime?

  webhook Webhook @relation(fields: [webhookId], references: [id])

  @@index([webhookId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([createdAt])
}

model LogEntry {
  id        String   @id @default(cuid())
  runId     String
  level     String   @default("INFO")
  message   String
  metadata  Json?
  timestamp DateTime @default(now())

  run ActorRun @relation(fields: [runId], references: [id])

  @@index([runId])
  @@index([runId, level])
}

enum EventType {
  RUN_CREATED
  RUN_SUCCEEDED
  RUN_FAILED
  RUN_CANCELED
  SCHEDULE_DISPATCHED
  ACTOR_PUBLISHED
  MARKETPLACE_LISTED
  MARKETPLACE_APPROVED
  MARKETPLACE_REJECTED
  MARKETPLACE_UNPUBLISHED
}

model PlatformEvent {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  actorVersionId String?
  runId       String?
  scheduleId  String?
  type        EventType
  message     String?
  payload     Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([type, createdAt])
  @@index([runId])
  @@index([actorId])
}

model RequestQueueItem {
  id         String    @id @default(cuid())
  queueId    String
  uniqueKey  String
  url        String?
  payload    Json?
  status     String    @default("PENDING")
  retryCount Int       @default(0)
  handledAt  DateTime?
  createdAt  DateTime  @default(now())

  queue RequestQueue @relation(fields: [queueId], references: [id])

  @@unique([queueId, uniqueKey])
  @@index([queueId, status])
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  UNPUBLISHED
}

model MarketplaceListing {
  id          String        @id @default(cuid())
  actorId     String
  publisherId String
  versionId   String?
  status      ListingStatus @default(PENDING)
  category    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  actor     Actor      @relation(fields: [actorId], references: [id])
  publisher User       @relation(fields: [publisherId], references: [id])

  @@unique([actorId])
  @@index([status, createdAt])
  @@index([publisherId])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceCents  Int      @default(0)
  runLimit    Int      @default(100)
  storageMb   Int      @default(100)
  interval    String   @default("monthly")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  workspaceId        String
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  createdAt          DateTime           @default(now())
  canceledAt         DateTime?

  plan Plan @relation(fields: [planId], references: [id])

  @@index([workspaceId])
  @@index([status, currentPeriodEnd])
}

model UsageRecord {
  id           String   @id @default(cuid())
  workspaceId  String
  periodStart  DateTime
  periodEnd    DateTime
  runsUsed     Int      @default(0)
  storageBytes Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([workspaceId, periodStart])
  @@index([workspaceId, periodEnd])
}
