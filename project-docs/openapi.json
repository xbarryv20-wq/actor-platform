      "post": {
        "summary": "Cancel a run",
        "tags": ["Runs"],
        "security": [{ "bearerAuth": ["runs:write"] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Run cancelled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CancelRunResponse" } } } } }
